{
  "expo": {
    "name": "Voice Timer",
    "slug": "voice_timer",
    "version": "1.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0b7285",
      "translucent": true
    },
    "plugins": [
      "./lib/withNotifeeAndroidFix",
      "expo-font"
    ],
    "android": {
      "permissions": [
        "WRITE_SETTINGS",
        "FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ADD8E6"
      },
      "package": "com.commitnobug.voice_timer"
    },
    "scheme": "voicetimer"
  }
}
