{
  "name": "voice_timer",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "npx expo start",
    "android": "cd android && ./gradlew --stop && cd .. && npx expo run:android && cd android && ./gradlew --stop && cd ..",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "bir": "cd android && ./gradlew --stop && ./gradlew assembleRelease && ./gradlew --stop && cd .. && adb install -r ./android/app/build/outputs/apk/release/app-release.apk && adb shell am start -n com.commitnobug.voice_timer/.MainActivity",
    "adbLog": "adb logcat *:S ReactNative:V ReactNativeJS:V MyApp:D AudioFocusModule Call VoskDebug:D YourTag:D AndroidRuntime:E System.err:W System.out:D *:F -v color -v long",
    "gradleClean": "cd android && ./gradlew clean && cd ..",
    "stopGradle": "cd android && ./gradlew --stop && cd .."
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@expo/vector-icons": "^15.0.2",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/checkbox": "0.5.20",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "57.0.26",
    "expo-brightness": "~57.0.2",
    "expo-keep-awake": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "libphonenumber-js": "^1.13.14",
    "mitt": "^3.0.1",
    "number-to-words": "^1.2.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-background-actions": "4.1.0",
    "react-native-dialog": "^9.3.0",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-simple-keypad": "^0.5.2",
    "react-native-sound": "^0.13.0",
    "react-native-svg": "15.15.4",
    "react-native-tts": "^4.1.1",
    "react-native-volume-manager": "^2.2.0",
    "react-native-vosk": "^2.1.7",
    "words-to-numbers": "^1.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@react-native-community/cli": "latest",
    "@types/intl": "^1.2.2",
    "@types/react": "^19.3.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.9"
  },
  "private": true
}
